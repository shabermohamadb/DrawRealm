        sc_pts = [(218, 395), (320, 412), (422, 395), (432, 470), (320, 492), (208, 470)]
        d.polygon(sc_pts, fill=(28, 32, 42, 255))
        d.line(sc_pts + [sc_pts[0]], fill=(15, 18, 24, 255), width=5)

