        d.polygon(visor_pts, fill=(6, 182, 212, 140))
        d.line(visor_pts + [visor_pts[0]], fill=(34, 211, 238, 255), width=6)
        d.line([(240, 292), (300, 292)], fill=(255, 255, 255, 220), width=3)
        d.line([(340, 304), (400, 304)], fill=(255, 255, 255, 220), width=3)

