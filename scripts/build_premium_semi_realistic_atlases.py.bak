def render_color_tile(arch):
    im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))

    skin_base, skin_shadow = arch["skin"]
    hair_base = arch["hair_base"] + (255,)
    hair_dark = arch["hair_dark"] + (255,)
    hair_hi = arch["hair_hi"] + (255,)
    c_base = arch["clothing_base"] + (255,)
    c_acc = arch["clothing_accent"] + (255,)
    style = arch["style"]
    c_type = arch["clothing_type"]

    # ---------------------------------------------------------
    # 1. Back Hair Layer (Behind neck and face)
    # ---------------------------------------------------------
    back_im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    bd = ImageDraw.Draw(back_im)

    if style == "twin_tails":
        l_pts = [(80, 115), (42, 165), (28, 255), (55, 305), (78, 260), (95, 185)]
        bd.polygon(l_pts, fill=hair_dark)
        bd.line(l_pts + [l_pts[0]], fill=(12, 12, 16, 255), width=3)
        r_pts = [(304, 115), (342, 165), (356, 255), (329, 305), (306, 260), (289, 185)]
        bd.polygon(r_pts, fill=hair_dark)
        bd.line(r_pts + [r_pts[0]], fill=(12, 12, 16, 255), width=3)
        # Hair ties
        bd.ellipse([72, 110, 88, 126], fill=c_acc)
        bd.ellipse([296, 110, 312, 126], fill=c_acc)
    elif style == "drill_curls":
        l_pts = [(85, 125), (45, 175), (35, 235), (55, 275), (45, 310), (70, 315), (75, 255), (65, 215), (92, 175)]
        r_pts = [(299, 125), (339, 175), (349, 235), (329, 275), (339, 310), (314, 315), (309, 255), (319, 215), (292, 175)]
        bd.polygon(l_pts, fill=hair_dark)
        bd.polygon(r_pts, fill=hair_dark)
        bd.line(l_pts + [l_pts[0]], fill=(12, 12, 16, 255), width=3)
        bd.line(r_pts + [r_pts[0]], fill=(12, 12, 16, 255), width=3)
    elif style == "high_ponytail":
        pony = [(235, 65), (315, 45), (348, 105), (328, 185), (288, 195), (268, 125)]
        bd.polygon(pony, fill=hair_dark)
        bd.line(pony + [pony[0]], fill=(12, 12, 16, 255), width=3)
        bd.ellipse([230, 60, 248, 78], fill=c_acc)
    elif style in ["flowing_waves", "wavy_layers", "hime_cut"]:
        b_pts_l = [(85, 115), (50, 175), (38, 255), (62, 315), (92, 305), (96, 235), (95, 160)]
        b_pts_r = [(299, 115), (334, 175), (346, 255), (322, 315), (292, 305), (288, 235), (289, 160)]
        bd.polygon(b_pts_l, fill=hair_dark)
        bd.polygon(b_pts_r, fill=hair_dark)
        bd.line(b_pts_l + [b_pts_l[0]], fill=(12, 12, 16, 255), width=3)
        bd.line(b_pts_r + [b_pts_r[0]], fill=(12, 12, 16, 255), width=3)
    elif style in ["wolf_cut", "messy_shonen"]:
        l_w = [(88, 120), (55, 175), (48, 235), (70, 255), (88, 220), (95, 160)]
        r_w = [(296, 120), (329, 175), (336, 235), (314, 255), (296, 220), (289, 160)]
        bd.polygon(l_w, fill=hair_dark)
        bd.polygon(r_w, fill=hair_dark)
    im.alpha_composite(back_im)

    # ---------------------------------------------------------
    # 2. Face, Neck & Streetwear Clothing Layer
    # ---------------------------------------------------------
    face_im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    fd = ImageDraw.Draw(face_im)

    # Neck
    neck_pts = [(152, 240), (150, 315), (234, 315), (232, 240)]
    fd.polygon(neck_pts, fill=skin_base + (255,))
    shadow_curve = bezier_curve((152, 248), (170, 280), (214, 280), (232, 248), 15)
    shadow_pts = shadow_curve + [(234, 285), (150, 285)]
    fd.polygon(shadow_pts, fill=skin_shadow + (255,))

    fd.line([(172, 275), (184, 315)], fill=skin_shadow + (140,), width=3)
    fd.line([(212, 275), (200, 315)], fill=skin_shadow + (140,), width=3)
    fd.line([(160, 318), (192, 324), (224, 318)], fill=skin_shadow + (180,), width=3)

    # Shoulders / Clothing
    if c_type == "tech_hoodie":
        hoodie_pts = [
            (20, 384), (35, 335), (95, 305), (145, 292), (192, 318), (239, 292),
            (289, 305), (349, 335), (364, 384)
        ]
        fd.polygon(hoodie_pts, fill=c_base)
        fd.line([(145, 292), (192, 318), (239, 292)], fill=c_acc, width=6)
        fd.line([(175, 318), (175, 370)], fill=(245, 245, 250, 255), width=4)
        fd.line([(209, 318), (209, 370)], fill=(245, 245, 250, 255), width=4)
        fd.line([(175, 366), (175, 372)], fill=c_acc, width=5)
        fd.line([(209, 366), (209, 372)], fill=c_acc, width=5)
        fd.line([(95, 305), (80, 384)], fill=(15, 15, 20, 180), width=3)
        fd.line([(289, 305), (304, 384)], fill=(15, 15, 20, 180), width=3)
        fd.line(hoodie_pts + [hoodie_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "tactical_jacket":
        jack_pts = [
            (20, 384), (35, 335), (95, 305), (140, 280), (165, 270), (192, 310),
            (219, 270), (244, 280), (289, 305), (349, 335), (364, 384)
        ]
        fd.polygon(jack_pts, fill=c_base)
        fd.line([(165, 270), (192, 310), (198, 384)], fill=(210, 215, 225, 255), width=4)
        fd.polygon([(90, 310), (125, 300), (120, 320), (85, 330)], fill=c_acc)
        fd.polygon([(294, 310), (259, 300), (264, 320), (299, 330)], fill=c_acc)
        fd.line(jack_pts + [jack_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "turtleneck":
        t_pts = [
            (20, 384), (35, 335), (95, 305), (145, 290), (145, 245), (192, 250),
            (239, 245), (239, 290), (289, 305), (349, 335), (364, 384)
        ]
        fd.polygon(t_pts, fill=c_base)
        for y_r in [260, 272, 284]:
            fd.line([(146, y_r), (238, y_r)], fill=c_acc, width=3)
        fd.line(t_pts + [t_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "bomber":
        b_pts = [
            (20, 384), (35, 330), (95, 305), (145, 300), (192, 335), (239, 300),
            (289, 305), (349, 330), (364, 384)
        ]
        fd.polygon(b_pts, fill=c_base)
        fd.line([(192, 335), (192, 384)], fill=(220, 225, 235, 255), width=5)
        fd.line([(145, 300), (192, 335), (239, 300)], fill=c_acc, width=6)
        fd.line(b_pts + [b_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "blazer_tie":
        blaz_pts = [
            (20, 384), (35, 335), (95, 305), (140, 300), (192, 360), (244, 300),
            (289, 305), (349, 335), (364, 384)
        ]
        fd.polygon(blaz_pts, fill=c_base)
        fd.polygon([(150, 300), (192, 350), (234, 300)], fill=(248, 250, 255, 255))
        fd.polygon([(188, 310), (196, 310), (194, 365), (190, 365)], fill=c_acc)
        fd.line([(140, 300), (170, 340), (192, 360)], fill=(15, 15, 20, 255), width=3)
        fd.line([(244, 300), (214, 340), (192, 360)], fill=(15, 15, 20, 255), width=3)
        fd.line(blaz_pts + [blaz_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "track_jacket":
        tr_pts = [
            (20, 384), (35, 335), (95, 305), (148, 290), (192, 305), (236, 290),
            (289, 305), (349, 335), (364, 384)
        ]
        fd.polygon(tr_pts, fill=c_base)
        fd.line([(60, 350), (115, 310)], fill=c_acc, width=4)
        fd.line([(324, 350), (269, 310)], fill=c_acc, width=4)
        fd.line([(192, 305), (192, 384)], fill=(230, 235, 245, 255), width=4)
        fd.line(tr_pts + [tr_pts[0]], fill=(15, 15, 20, 255), width=4)

    elif c_type == "cozy_scarf":
        sh_pts = [(20, 384), (35, 335), (95, 310), (289, 310), (349, 335), (364, 384)]
        fd.polygon(sh_pts, fill=(30, 35, 45, 255))
        sc_pts = [(130, 260), (192, 275), (254, 260), (262, 320), (192, 340), (122, 320)]
        fd.polygon(sc_pts, fill=c_base)
        fd.polygon([(175, 315), (210, 315), (215, 375), (170, 375)], fill=c_acc)
        fd.line(sc_pts + [sc_pts[0]], fill=(15, 15, 20, 255), width=4)

    else:
        c_pts = [
            (20, 384), (35, 335), (95, 310), (148, 300), (192, 335), (236, 300),
            (289, 310), (349, 335), (364, 384)
        ]
        fd.polygon(c_pts, fill=c_base)
        fd.polygon([(155, 300), (192, 335), (229, 300)], fill=c_acc)
        fd.line(c_pts + [c_pts[0]], fill=(15, 15, 20, 255), width=4)

    # Ears
    fd.ellipse([82, 148, 108, 205], fill=skin_base + (255,), outline=(170, 125, 105, 255), width=3)
    fd.ellipse([88, 160, 104, 192], fill=skin_shadow + (255,))
    fd.ellipse([276, 148, 302, 205], fill=skin_base + (255,), outline=(170, 125, 105, 255), width=3)
    fd.ellipse([280, 160, 296, 192], fill=skin_shadow + (255,))

    # Jawline
    left_jaw = bezier_curve((96, 110), (94, 180), (120, 240), (192, 274), 25)
    right_jaw = bezier_curve((192, 274), (264, 240), (290, 180), (288, 110), 25)
    head_top = bezier_curve((288, 110), (280, 60), (104, 60), (96, 110), 20)
    face_contour = left_jaw + right_jaw + head_top

    fd.polygon(face_contour, fill=skin_base + (255,))
    fd.line(left_jaw + right_jaw, fill=(170, 125, 105, 255), width=3)

    # Soft Cheek Blush
    blush = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    bd = ImageDraw.Draw(blush)
    bd.ellipse([115, 185, 155, 215], fill=(248, 125, 125, 125))
    bd.ellipse([229, 185, 269, 215], fill=(248, 125, 125, 125))
    blush = blush.filter(ImageFilter.GaussianBlur(radius=8))
    face_im.alpha_composite(blush)

    # Sculpted Nose
    fd = ImageDraw.Draw(face_im)
    fd.line([(190, 182), (190, 216)], fill=skin_shadow + (140,), width=2)
    fd.line([(192, 184), (192, 217)], fill=(255, 250, 245, 180), width=2)
    fd.ellipse([191, 217, 194, 220], fill=(255, 255, 255, 230))
    fd.polygon([(187, 223), (192, 222), (197, 224), (192, 225)], fill=(160, 110, 90, 255))

    im.alpha_composite(face_im)

    # ---------------------------------------------------------
    # 3. Front Hair Layer (Crown & Bangs Framing Face)
    # ---------------------------------------------------------
    front_im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    frd = ImageDraw.Draw(front_im)

    crown_top = bezier_curve((60, 115), (75, 45), (150, 22), (192, 22), 20) + \
                bezier_curve((192, 22), (234, 22), (309, 45), (324, 115), 20)
    hairline = bezier_curve((324, 115), (280, 90), (104, 90), (60, 115), 20)
    frd.polygon(crown_top + hairline, fill=hair_base)

    # Temple locks framing cheeks
    left_lock = [(60, 115), (70, 160), (82, 225), (96, 238), (92, 185), (80, 125)]
    frd.polygon(left_lock, fill=hair_base)
    frd.line(left_lock + [left_lock[0]], fill=(12, 12, 16, 255), width=2)

    right_lock = [(324, 115), (314, 160), (302, 225), (288, 238), (292, 185), (304, 125)]
    frd.polygon(right_lock, fill=hair_base)
    frd.line(right_lock + [right_lock[0]], fill=(12, 12, 16, 255), width=2)

    # Specific bang cuts per style
    if style in ["curtain_bangs", "flowing_waves"]:
        # Wide center parted curtain bangs
        b_l = [(120, 88), (145, 105), (160, 124), (168, 108), (150, 86)]
        b_r = [(264, 88), (239, 105), (224, 124), (216, 108), (234, 86)]
        frd.polygon(b_l, fill=hair_base)
        frd.polygon(b_r, fill=hair_base)
        frd.line(b_l + [b_l[0]], fill=(12, 12, 16, 255), width=2)
        frd.line(b_r + [b_r[0]], fill=(12, 12, 16, 255), width=2)
    elif style in ["side_part_fringe", "hime_cut"]:
        # Diagonal swept fringe
        b_l = [(110, 88), (135, 112), (165, 126), (175, 108), (145, 86)]
        b_c = [(150, 86), (180, 110), (205, 124), (215, 106), (185, 86)]
        frd.polygon(b_l, fill=hair_base)
        frd.polygon(b_c, fill=hair_base)
        frd.line(b_l + [b_l[0]], fill=(12, 12, 16, 255), width=2)
        frd.line(b_c + [b_c[0]], fill=(12, 12, 16, 255), width=2)
    else: # messy_shonen / runner_spikes / wolf_cut / twin_tails / short_undercut / etc.
        b1 = [(110, 88), (125, 105), (135, 126), (138, 105), (130, 86)]
        b2 = [(145, 86), (155, 105), (165, 122), (170, 105), (160, 86)]
        b3 = [(225, 86), (220, 105), (218, 122), (228, 105), (240, 86)]
        b4 = [(255, 88), (248, 105), (248, 126), (260, 105), (275, 88)]
        for b in [b1, b2, b3, b4]:
            frd.polygon(b, fill=hair_base)
            frd.line(b + [b[0]], fill=(12, 12, 16, 255), width=2)

    # Dynamic top hair tufts / spikes
    frd.polygon([(170, 24), (185, 10), (192, 22)], fill=hair_base)
    frd.polygon([(192, 22), (205, 12), (215, 24)], fill=hair_base)

    # Angel Ring Sheen
    halo = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    hd = ImageDraw.Draw(halo)
    halo_pts = [(110, 68), (150, 55), (192, 50), (234, 55), (274, 68), (268, 78), (192, 62), (116, 78)]
    hd.polygon(halo_pts, fill=hair_hi)
    halo = halo.filter(ImageFilter.GaussianBlur(radius=4))
    front_im.alpha_composite(halo)

    frd = ImageDraw.Draw(front_im)
    frd.line(crown_top, fill=(15, 15, 20, 255), width=3)

    if style == "runner_spikes":
        frd.polygon([(94, 98), (192, 85), (290, 98), (290, 118), (192, 105), (94, 118)], fill=(250, 250, 252, 255))
        frd.line([(94, 98), (192, 85), (290, 98), (290, 118), (192, 105), (94, 118), (94, 98)], fill=(30, 30, 35, 255), width=3)

    im.alpha_composite(front_im)

    return im.resize((96, 96), Image.Resampling.LANCZOS)


# ==============================================================================
# 2. EYES ATLAS — 57 EYE STYLES (Multi-layer Luminous Depth)
# ==============================================================================

EYE_PALETTES = [
    ("sapphire", (18, 45, 115), (30, 130, 235), (105, 220, 255)),
    ("ruby", (110, 14, 25), (220, 35, 55), (255, 130, 150)),
    ("emerald", (8, 65, 45), (16, 185, 129), (110, 245, 195)),
    ("amethyst", (65, 18, 105), (168, 85, 247), (230, 190, 255)),
    ("amber", (115, 55, 10), (234, 140, 15), (254, 225, 95)),
    ("cyan", (12, 85, 105), (6, 182, 212), (165, 243, 252)),
    ("rose", (125, 20, 55), (244, 63, 94), (254, 180, 200)),
    ("slate", (35, 45, 60), (100, 116, 139), (203, 213, 225)),
    ("gold", (110, 75, 12), (218, 165, 32), (254, 240, 138)),
]

def render_eyes_tile(idx):
    im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)

    p_name, c_base, c_mid, c_light = EYE_PALETTES[idx % len(EYE_PALETTES)]
    shape_type = idx % 7
    brow_type = (idx // 7) % 5

    # Eyebrows
    brow_col = (28, 22, 24, 255)
    if brow_type == 0: # Confident arched
        d.line([(120, 142), (145, 132), (174, 137)], fill=brow_col, width=5)
        d.line([(126, 140), (150, 131)], fill=brow_col, width=4)
        d.line([(210, 137), (239, 132), (264, 142)], fill=brow_col, width=5)
        d.line([(234, 131), (258, 140)], fill=brow_col, width=4)
    elif brow_type == 1: # Determined sharp slant
        d.line([(120, 144), (145, 134), (174, 128)], fill=brow_col, width=5)
        d.line([(128, 142), (152, 132)], fill=brow_col, width=4)
        d.line([(210, 128), (239, 134), (264, 144)], fill=brow_col, width=5)
        d.line([(232, 132), (256, 142)], fill=brow_col, width=4)
    elif brow_type == 2: # Gentle soft curved
        d.line([(120, 138), (145, 132), (174, 138)], fill=brow_col, width=5)
        d.line([(210, 138), (239, 132), (264, 138)], fill=brow_col, width=5)
    elif brow_type == 3: # Inquisitive / raised
        d.line([(120, 132), (145, 124), (174, 130)], fill=brow_col, width=5)
        d.line([(210, 134), (239, 130), (264, 138)], fill=brow_col, width=5)
    else: # Stoic straight
        d.line([(120, 139), (174, 139)], fill=brow_col, width=5)
        d.line([(210, 139), (264, 139)], fill=brow_col, width=5)

    # Double-eyelid fold
    crease = (180, 135, 115, 180)
    d.line([(130, 150), (148, 145), (168, 149)], fill=crease, width=2)
    d.line([(216, 149), (236, 145), (254, 150)], fill=crease, width=2)

    # Sclera & Eye Rendering
    if shape_type == 0: # Classic Winged Cat Lash
        d.polygon([(126, 165), (148, 153), (172, 163), (166, 188), (136, 188)], fill=(250, 252, 255, 255))
        d.polygon([(212, 163), (236, 153), (258, 165), (248, 188), (218, 188)], fill=(250, 252, 255, 255))
        d.polygon([(126, 165), (148, 153), (172, 163), (169, 170), (130, 170)], fill=(195, 202, 218, 150))
        d.polygon([(212, 163), (236, 153), (258, 165), (254, 170), (215, 170)], fill=(195, 202, 218, 150))
        for cx in [150, 234]:
            d.ellipse([cx - 15, 154, cx + 15, 190], fill=c_base + (255,))
            d.chord([cx - 14, 164, cx + 14, 189], start=0, end=180, fill=c_mid + (255,))
            d.chord([cx - 11, 173, cx + 11, 188], start=0, end=180, fill=c_light + (255,))
            d.ellipse([cx - 5, 163, cx + 5, 177], fill=(12, 15, 24, 255))
            d.ellipse([cx - 9, 160, cx - 2, 169], fill=(255, 255, 255, 255))
            d.ellipse([cx + 4, 175, cx + 10, 182], fill=(255, 255, 255, 210))
        d.line([(120, 167), (135, 155), (156, 153), (176, 162)], fill=(20, 20, 25, 255), width=7)
        d.line([(117, 168), (128, 160)], fill=(20, 20, 25, 255), width=5)
        d.line([(208, 162), (228, 153), (249, 155), (264, 167)], fill=(20, 20, 25, 255), width=7)
        d.line([(256, 160), (267, 168)], fill=(20, 20, 25, 255), width=5)
        d.line([(136, 189), (164, 189)], fill=(120, 85, 75, 190), width=2)
        d.line([(220, 189), (248, 189)], fill=(120, 85, 75, 190), width=2)

    elif shape_type == 1: # Shojo Starry Catchlights
        d.polygon([(124, 163), (148, 150), (174, 160), (168, 190), (134, 190)], fill=(250, 252, 255, 255))
        d.polygon([(210, 160), (236, 150), (260, 163), (250, 190), (216, 190)], fill=(250, 252, 255, 255))
        d.polygon([(124, 163), (148, 150), (174, 160), (170, 168), (128, 168)], fill=(195, 202, 218, 150))
        d.polygon([(210, 160), (236, 150), (260, 163), (256, 168), (214, 168)], fill=(195, 202, 218, 150))
        for cx in [150, 234]:
            d.ellipse([cx - 16, 152, cx + 16, 190], fill=c_base + (255,))
            d.chord([cx - 15, 162, cx + 15, 189], start=0, end=180, fill=c_mid + (255,))
            d.chord([cx - 12, 172, cx + 12, 188], start=0, end=180, fill=c_light + (255,))
            d.ellipse([cx - 5, 162, cx + 5, 176], fill=(12, 15, 24, 255))
            d.ellipse([cx - 10, 158, cx - 3, 167], fill=(255, 255, 255, 255))
            d.ellipse([cx + 4, 174, cx + 10, 181], fill=(255, 255, 255, 230))
            d.ellipse([cx - 7, 178, cx - 3, 182], fill=(255, 255, 255, 190))
        d.line([(119, 165), (148, 150), (177, 160)], fill=(20, 20, 25, 255), width=7)
        d.line([(207, 160), (236, 150), (265, 165)], fill=(20, 20, 25, 255), width=7)
        d.line([(134, 190), (164, 190)], fill=(120, 85, 75, 190), width=2)
        d.line([(220, 190), (250, 190)], fill=(120, 85, 75, 190), width=2)

    elif shape_type == 2: # Cool / Sleepy Half-Closed
        d.polygon([(126, 167), (148, 159), (174, 164), (166, 183), (134, 183)], fill=(250, 252, 255, 255))
        d.polygon([(210, 164), (236, 159), (258, 167), (250, 183), (218, 183)], fill=(250, 252, 255, 255))
        d.polygon([(126, 167), (148, 159), (174, 164), (170, 172), (130, 172)], fill=(185, 195, 215, 180))
        d.polygon([(210, 164), (236, 159), (258, 167), (254, 172), (214, 172)], fill=(185, 195, 215, 180))
        for cx in [150, 234]:
            d.ellipse([cx - 13, 160, cx + 13, 184], fill=c_base + (255,))
            d.chord([cx - 12, 168, cx + 12, 183], start=0, end=180, fill=c_mid + (255,))
            d.ellipse([cx - 4, 164, cx + 4, 176], fill=(12, 15, 24, 255))
            d.ellipse([cx - 8, 163, cx - 2, 169], fill=(255, 255, 255, 255))
        d.line([(120, 166), (148, 158), (176, 163)], fill=(20, 20, 25, 255), width=7)
        d.line([(208, 163), (236, 158), (264, 166)], fill=(20, 20, 25, 255), width=7)
        d.line([(134, 184), (164, 184)], fill=(120, 85, 75, 180), width=2)
        d.line([(220, 184), (250, 184)], fill=(120, 85, 75, 180), width=2)

    elif shape_type == 3: # Intense Determined Glare
        d.polygon([(126, 163), (148, 155), (174, 163), (166, 182), (136, 182)], fill=(250, 252, 255, 255))
        d.polygon([(210, 163), (236, 155), (258, 163), (248, 182), (218, 182)], fill=(250, 252, 255, 255))
        for cx in [150, 234]:
            d.ellipse([cx - 12, 155, cx + 12, 182], fill=c_base + (255,))
            d.chord([cx - 11, 163, cx + 11, 181], start=0, end=180, fill=c_mid + (255,))
            d.ellipse([cx - 4, 162, cx + 4, 174], fill=(12, 15, 24, 255))
            d.ellipse([cx - 7, 160, cx - 2, 166], fill=(255, 255, 255, 255))
        d.line([(120, 162), (148, 154), (176, 162)], fill=(20, 20, 25, 255), width=8)
        d.line([(208, 162), (236, 154), (264, 162)], fill=(20, 20, 25, 255), width=8)
        d.line([(136, 183), (164, 183)], fill=(120, 85, 75, 200), width=2)
        d.line([(220, 183), (248, 183)], fill=(120, 85, 75, 200), width=2)

    elif shape_type == 4: # Radiant Smiling Curved (^^)
        d.arc([124, 155, 176, 188], start=190, end=350, fill=(20, 20, 25, 255), width=7)
        d.arc([208, 155, 260, 188], start=190, end=350, fill=(20, 20, 25, 255), width=7)
        d.line([(120, 172), (132, 164)], fill=(20, 20, 25, 255), width=5)
        d.line([(252, 164), (264, 172)], fill=(20, 20, 25, 255), width=5)

    elif shape_type == 5: # Holographic Cyber Target Rings
        d.polygon([(126, 165), (148, 153), (172, 163), (166, 188), (136, 188)], fill=(15, 20, 35, 255))
        d.polygon([(212, 163), (236, 153), (258, 165), (248, 188), (218, 188)], fill=(15, 20, 35, 255))
        for cx in [150, 234]:
            d.ellipse([cx - 14, 158, cx + 14, 186], outline=c_mid + (255,), width=3)
            d.ellipse([cx - 5, 167, cx + 5, 177], fill=c_light + (255,))
            d.line([(cx - 16, 172), (cx - 9, 172)], fill=c_light + (255,), width=2)
            d.line([(cx + 9, 172), (cx + 16, 172)], fill=c_light + (255,), width=2)
        d.line([(120, 167), (148, 154), (176, 162)], fill=(20, 20, 25, 255), width=7)
        d.line([(208, 162), (236, 154), (264, 167)], fill=(20, 20, 25, 255), width=7)

    else: # Playful Wink
        d.arc([124, 157, 176, 190], start=190, end=350, fill=(20, 20, 25, 255), width=7)
        d.line([(120, 174), (132, 166)], fill=(20, 20, 25, 255), width=5)
        d.polygon([(212, 163), (236, 153), (258, 165), (248, 188), (218, 188)], fill=(250, 252, 255, 255))
        d.ellipse([219, 154, 249, 190], fill=c_base + (255,))
        d.chord([220, 164, 248, 189], start=0, end=180, fill=c_mid + (255,))
        d.chord([223, 173, 245, 188], start=0, end=180, fill=c_light + (255,))
        d.ellipse([229, 163, 239, 177], fill=(12, 15, 24, 255))
        d.ellipse([225, 160, 232, 169], fill=(255, 255, 255, 255))
        d.ellipse([238, 175, 244, 182], fill=(255, 255, 255, 210))
        d.line([(208, 162), (228, 153), (249, 155), (264, 167)], fill=(20, 20, 25, 255), width=7)
        d.line([(256, 160), (267, 168)], fill=(20, 20, 25, 255), width=5)
        d.line([(220, 189), (248, 189)], fill=(120, 85, 75, 190), width=2)

    return im.resize((96, 96), Image.Resampling.LANCZOS)


# ==============================================================================
# 3. MOUTH ATLAS — 51 EXPRESSIONS (3D Lip Volumetrics & Shading)
# ==============================================================================

def render_mouth_tile(idx):
    im = Image.new("RGBA", (W_96, H_96), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)

    m_type = idx % 10
    w_scale = 1.0 + (idx % 3) * 0.12
    y_shift = ((idx // 10) % 3) * 2

    lip_line = (140, 50, 55, 255)
    corner_tuck = (100, 35, 40, 255)
    lip_shadow = (185, 105, 95, 160)
    lip_highlight = (255, 240, 235, 210)

    if m_type == 0: # Confident subtle smirk
        p1 = (192 - int(18 * w_scale), 246 + y_shift)
        p2 = (192, 247 + y_shift)
        p3 = (192 + int(14 * w_scale), 243 + y_shift)
        p4 = (192 + int(21 * w_scale), 239 + y_shift)
        d.line([p1, p2, p3, p4], fill=lip_line, width=4)
        d.ellipse([p1[0] - 1, p1[1] - 1, p1[0] + 1, p1[1] + 1], fill=corner_tuck)
        d.ellipse([p4[0] - 1, p4[1] - 1, p4[0] + 1, p4[1] + 1], fill=corner_tuck)
        d.chord([184, 252 + y_shift, 202, 258 + y_shift], start=0, end=180, fill=lip_shadow)
        d.line([(188, 253 + y_shift), (196, 253 + y_shift)], fill=lip_highlight, width=2)

    elif m_type == 1: # Warm gentle smile
        hw = int(18 * w_scale)
        p1 = (192 - hw, 245 + y_shift)
        p2 = (192, 249 + y_shift)
        p3 = (192 + hw, 245 + y_shift)
        d.line([p1, p2, p3], fill=lip_line, width=4)
        d.ellipse([p1[0] - 1, p1[1] - 1, p1[0] + 1, p1[1] + 1], fill=corner_tuck)
        d.ellipse([p3[0] - 1, p3[1] - 1, p3[0] + 1, p3[1] + 1], fill=corner_tuck)
        d.chord([184, 253 + y_shift, 202, 259 + y_shift], start=0, end=180, fill=lip_shadow)
        d.line([(188, 254 + y_shift), (196, 254 + y_shift)], fill=lip_highlight, width=2)

    elif m_type == 2: # Cheerful open smile
        hw = int(18 * w_scale)
        pts = [(192 - hw, 242 + y_shift), (192 + hw, 242 + y_shift), (192, 263 + y_shift)]
        d.polygon(pts, fill=(136, 19, 55, 255))
        d.polygon([(192 - hw + 2, 242 + y_shift), (192 + hw - 2, 242 + y_shift), (192 + hw - 6, 247 + y_shift), (192 - hw + 6, 247 + y_shift)], fill=(255, 255, 255, 255))
        d.ellipse([192 - int(9 * w_scale), 253 + y_shift, 192 + int(9 * w_scale), 265 + y_shift], fill=(251, 113, 133, 255))
        d.line([pts[0], pts[1]], fill=lip_line, width=4)
        d.line([pts[0], pts[2], pts[1]], fill=lip_line, width=4)

    elif m_type == 3: # Focused grit / clenched teeth
        hw = int(18 * w_scale)
        x1 = 192 - hw
        x2 = 192 + hw
        y = 245 + y_shift
        d.rounded_rectangle([x1, y - 4, x2, y + 4], radius=3, fill=(252, 252, 255, 255), outline=lip_line, width=4)
        d.line([(192, y - 4), (192, y + 4)], fill=lip_line, width=2)
        d.chord([184, y + 7, 200, y + 13], start=0, end=180, fill=lip_shadow)

    elif m_type == 4: # Cute anime cat mouth (:3)
        cy = 245 + y_shift
        hw = int(14 * w_scale)
        d.arc([192 - hw, cy - 5, 192, cy + 7], start=20, end=165, fill=lip_line, width=4)
        d.arc([192, cy - 5, 192 + hw, cy + 7], start=15, end=160, fill=lip_line, width=4)
        d.ellipse([192 - hw, cy - 1, 192 - hw + 2, cy + 1], fill=corner_tuck)
        d.ellipse([192 + hw - 2, cy - 1, 192 + hw, cy + 1], fill=corner_tuck)
        d.chord([188, cy + 9, 196, cy + 14], start=0, end=180, fill=lip_shadow)

    elif m_type == 5: # Teasing playful tongue out (:P)
        hw = int(16 * w_scale)
        p1 = (192 - hw, 244 + y_shift)
        p2 = (192 + hw, 244 + y_shift)
        d.line([p1, p2], fill=lip_line, width=4)
        d.rounded_rectangle([192 - 7, 244 + y_shift, 192 + 7, 260 + y_shift], radius=6, fill=(251, 113, 133, 255), outline=lip_line, width=3)
        d.line([(192, 246 + y_shift), (192, 254 + y_shift)], fill=(225, 29, 72, 255), width=2)

    elif m_type == 6: # Small surprised 'o'
        rw = int(7 * w_scale)
        rh = int(9 * w_scale)
        d.ellipse([192 - rw, 243 + y_shift, 192 + rw, 243 + y_shift + rh], fill=(136, 19, 55, 255), outline=lip_line, width=4)
        d.chord([185, 243 + y_shift + rh + 3, 199, 243 + y_shift + rh + 8], start=0, end=180, fill=lip_shadow)

    elif m_type == 7: # Stoic calm line
        hw = int(14 * w_scale)
        d.line([(192 - hw, 247 + y_shift), (192 + hw, 247 + y_shift)], fill=lip_line, width=4)
        d.ellipse([192 - hw - 1, 246 + y_shift, 192 - hw + 1, 248 + y_shift], fill=corner_tuck)
        d.ellipse([192 + hw - 1, 246 + y_shift, 192 + hw + 1, 248 + y_shift], fill=corner_tuck)
        d.chord([184, 253 + y_shift, 200, 258 + y_shift], start=0, end=180, fill=lip_shadow)

    elif m_type == 8: # Wide triumphant open laugh
        hw = int(20 * w_scale)
        pts = [(192 - hw, 241 + y_shift), (192 + hw, 241 + y_shift), (192, 268 + y_shift)]
        d.polygon(pts, fill=(159, 18, 57, 255))
        d.polygon([(192 - hw + 3, 241 + y_shift), (192 + hw - 3, 241 + y_shift), (192 + hw - 7, 247 + y_shift), (192 - hw + 7, 247 + y_shift)], fill=(255, 255, 255, 255))
        d.ellipse([192 - 11, 254 + y_shift, 192 + 11, 270 + y_shift], fill=(251, 113, 133, 255))
        d.line(pts + [pts[0]], fill=lip_line, width=4)

    else: # Tsundere cute wavy lip
        hw = int(16 * w_scale)
        p1 = (192 - hw, 250 + y_shift)
        p2 = (192 - 6, 245 + y_shift)
        p3 = (192 + 6, 250 + y_shift)
        p4 = (192 + hw, 245 + y_shift)
        d.line([p1, p2, p3, p4], fill=lip_line, width=4)
        d.chord([184, 254 + y_shift, 200, 259 + y_shift], start=0, end=180, fill=lip_shadow)

    return im.resize((96, 96), Image.Resampling.LANCZOS)


# ==============================================================================
# 4. SPECIAL ATLAS — 20 MODERN ACCESSORIES (640x640 -> 160x160)
# ==============================================================================

def render_special_tile(idx):
    im = Image.new("RGBA", (W_160, H_160), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)

    acc_id = idx % 20

    # Alignment offset: +128
    # Head top Y=150, Eyes Y=299, Ears X=220 & 420 (Y=300), Mouth Y=374, Neck Y=390..440
    if acc_id == 0: # Pro Cyan RGB Gaming Headset
        d.arc([160, 60, 480, 420], start=185, end=355, fill=(28, 35, 48, 255), width=26)
