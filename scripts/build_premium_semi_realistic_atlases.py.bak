        visor_pts = [(215, 276), (320, 264), (425, 276), (420, 322), (320, 334), (220, 322)]
        d.polygon(visor_pts, fill=(245, 158, 11, 150))
        d.line(visor_pts + [visor_pts[0]], fill=(251, 191, 36, 255), width=6)

    elif acc_id == 8: # Kitsune Fox Mask
        mask_pts = [(320, 130), (360, 60), (405, 130), (425, 175), (360, 215), (295, 175)]
        d.polygon(mask_pts, fill=(252, 252, 255, 255))
        d.polygon([(350, 90), (360, 65), (370, 90)], fill=(220, 38, 38, 255))
