    elif acc_id == 9: # Shinobi Metal Forehead Protector
        band_pts = [(218, 222), (320, 210), (422, 222), (422, 250), (320, 238), (218, 250)]
        d.polygon(band_pts, fill=(24, 24, 27, 255))
        plate_pts = [(270, 220), (320, 215), (370, 220), (370, 244), (320, 246), (270, 244)]
        d.polygon(plate_pts, fill=(203, 213, 225, 255))
        d.line(plate_pts + [plate_pts[0]], fill=(30, 41, 59, 255), width=4)
        d.ellipse([315, 226, 325, 236], fill=(30, 41, 59, 255))

    elif acc_id == 10: # Twin Golden Star Hairpins
        def draw_star(cx, cy, r):
            pts = []
            for i in range(10):
                angle = i * math.pi / 5 - math.pi / 2
                rad = r if i % 2 == 0 else r * 0.45
                pts.append((cx + rad * math.cos(angle), cy + rad * math.sin(angle)))
            d.polygon(pts, fill=(250, 204, 21, 255))
            d.line(pts + [pts[0]], fill=(180, 83, 9, 255), width=3)
        draw_star(235, 180, 18)
        draw_star(258, 198, 14)

    elif acc_id == 11: # Sakura Cherry Blossom Hairclip
        cx, cy = 240, 185
        for i in range(5):
            angle = i * 2 * math.pi / 5
            px = cx + 18 * math.cos(angle)
            py = cy + 18 * math.sin(angle)
            d.ellipse([px - 11, py - 11, px + 11, py + 11], fill=(251, 113, 133, 255))
        d.ellipse([cx - 7, cy - 7, cx + 7, cy + 7], fill=(254, 240, 138, 255))

    elif acc_id == 12: # Anime Protagonist Cheek Cross Bandage
        d.polygon([(230, 320), (265, 308), (258, 338), (224, 350)], fill=(254, 243, 199, 255))
        d.polygon([(230, 308), (265, 350), (252, 356), (218, 314)], fill=(254, 243, 199, 255))
        d.line([(224, 325), (258, 314)], fill=(217, 119, 6, 255), width=2)

