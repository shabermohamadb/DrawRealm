# DrawRealm Production Environment Variables
# Copy to .env and configure for your production deployment

# Port to listen on
PORT=3001

# Environment: production or development
NODE_ENV=production

# SQLite database file or PostgreSQL connection URL
DATABASE_URL=./server/data/drawrealm.sqlite

# Supabase PostgreSQL Configuration (Server-Only, Never expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# CORS allowed origins (e.g. https://drawrealm.com or * for open)
CORS_ORIGIN=*

# Reconnection grace periods in milliseconds
RECONNECT_GRACE_PERIOD_MS=30000
DRAWER_RECONNECT_GRACE_PERIOD_MS=15000

# Limits
MAX_ROOMS=500
MAX_PLAYERS_PER_ROOM=20

# Secret key for tokens and session verification
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
